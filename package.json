{
  "name": "monograph-astro-theme",
  "description": "A text-first Astro blog theme with command-palette search and a light/dark reading mode.",
  "type": "module",
  "version": "1.0.0",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": false,
  "keywords": [
    "astro-theme",
    "astro",
    "blog",
    "minimal",
    "editorial",
    "writing",
    "tailwindcss"
  ],
  "homepage": "https://monograph.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/monograph.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cloudinary:breakpoints": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/cloudinary-breakpoints.mjs",
    "test:images": "node --test scripts/cloudinary.test.mjs",
    "check:cloudinary-build": "node scripts/check-cloudinary-build.mjs"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "cloudinary": "^2.11.0",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.16.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
